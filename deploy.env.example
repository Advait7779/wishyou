# Set these in Coolify's environment settings before deployment.
# Use only URL-safe hexadecimal characters for POSTGRES_PASSWORD because it
# is inserted into DATABASE_URL in compose.yaml.
POSTGRES_PASSWORD=replace-with-at-least-32-random-hex-characters
JWT_SECRET=replace-with-at-least-32-random-characters
CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
WEB_ORIGIN=https://your-domain.com
SMS_RATE_PER_SECOND=5
VOICE_RATE_PER_SECOND=1
IMPORT_MAX_EXPANDED_GB=500
IMPORT_SHARED_STRING_MEMORY_MB=32
