PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://wishyou:wishyou@localhost:5432/wishyou
JWT_SECRET=replace-with-a-long-random-secret
CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=0
BUSINESS_TIMEZONE=Asia/Kolkata
# PYTHON_BIN=/absolute/path/to/python
# Optional: set an absolute path on a volume with room for a 50 GiB upload and database growth.
# IMPORT_UPLOAD_DIR=A:/Projects/wishyou.com/backend/uploads
IMPORT_MAX_EXPANDED_GB=500
# XLSX shared strings above this size spill to a temporary SQLite file.
IMPORT_SHARED_STRING_MEMORY_MB=32
# Keep these at or below the provider's allowed request rates.
SMS_RATE_PER_SECOND=5
VOICE_RATE_PER_SECOND=1
