# For a physical phone, use the computer's LAN IP (same Wi-Fi) or a hosted HTTPS API.
# When unset in Expo Go, the app uses the Expo development server's host with port 4001 (paused test API).
# Use port 4000 below only when deliberately testing the normal sending-enabled backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# A signed release requires HTTPS:
# EXPO_PUBLIC_API_URL=https://your-domain.com
